{
  "name": "omp-web",
  "version": "0.1.0",
  "description": "Web UI for the oh-my-pi (omp) coding agent",
  "homepage": "https://github.com/omp-web/omp-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omp-web/omp-web.git"
  },
  "bugs": {
    "url": "https://github.com/omp-web/omp-web/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "omp-web": "bin/omp-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 30177",
    "dev:lan": "next dev -H 0.0.0.0 -p 30177",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30177",
    "start:lan": "next start -H 0.0.0.0 -p 30177",
    "lint": "eslint .",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "8.5.0",
    "yaml": "^2"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
